// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum Role {
  ADMIN
  HR
  PM
  EMPLOYEE
  DEPARTMENT_HEAD
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Language {
  VI
  EN
  KO
}

enum AttendanceStatus {
  ON_TIME
  LATE
  VERY_LATE
  WFH
  BUSINESS_TRIP
  ABSENT_APPROVED
  ABSENT_UNAPPROVED
  EARLY_LEAVE_APPROVED
  EARLY_LEAVE_UNAPPROVED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
}

enum BreakType {
  MANUAL
  EARLY_LEAVE_OUT
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  COMPENSATORY
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectKind {
  TEAM
  PERSONAL
}

enum ProjectWorkflowType {
  SCRUM
  KANBAN
  DAILY
  SIMPLE
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MeetingScope {
  PROJECT
  DEPARTMENT
  ONE_ON_ONE
}

enum RSVP {
  PENDING
  ACCEPTED
  DECLINED
}

enum AiJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum DocVisibility {
  PUBLIC
  PRIVATE
  SHARED
}

enum SharePerm {
  VIEW
  EDIT
}

enum DocumentScope {
  PERSONAL
  PROJECT
  DEPARTMENT
  COMPANY
}

enum DocumentType {
  STANDARD
  TASK_REQUIREMENT
  TASK_SUBMISSION
  MEETING_MINUTES
  COMPANY_POLICY
  TEMPLATE
}

enum NotificationType {
  MEETING
  ATTENDANCE_APPROVAL
  QUICK_TASK
  MENTION
  TASK
  SYSTEM
}

// ------------------------------------------------------
// Models
// ------------------------------------------------------

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  avatar       String?
  role         Role        @default(EMPLOYEE)
  status       UserStatus  @default(ACTIVE)
  position     String?
  language     Language    @default(VI)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  // Relations
  attendanceRecords   AttendanceRecord[]
  wfhRequests         WfhRequest[]
  leaveRequests       LeaveRequest[]
  createdProjects     Project[]            @relation("ProjectCreator")
  personalProject     Project?             @relation("PersonalProjectOwner")
  managedProjects     Project[]            @relation("ProjectManager")
  projectMemberships  ProjectMember[]
  createdTasks        Task[]               @relation("TaskCreator")
  assignedTasks       Task[]               @relation("TaskAssignee")
  completedTasks      Task[]               @relation("TaskCompletedBy")
  workLogs            WorkLog[]
  comments            Comment[]
  reactions           Reaction[]
  createdMeetings     Meeting[]            @relation("MeetingCreator")
  meetingAttendees    MeetingAttendee[]

  // QuickTask relations (M3.5)
  quickTasksAssigned  QuickTask[] @relation("QuickTaskAssignee")
  quickTasksAssignedBy QuickTask[] @relation("QuickTaskAssigner")

  // Attendance Enhancement (GD2)
  earlyLeaveRequests         EarlyLeaveRequest[] @relation("EarlyLeaveRequester")
  reviewedEarlyLeaveRequests EarlyLeaveRequest[] @relation("EarlyLeaveReviewer")
  overtimeRequests           OvertimeRequest[]   @relation("OvertimeRequester")
  reviewedOvertimeRequests   OvertimeRequest[]   @relation("OvertimeReviewer")
  breakLogs                  BreakLog[]
  ownedDocuments             Document[]          @relation("DocumentOwner")
  createdDocuments           Document[]          @relation("DocumentCreator")
  updatedDocuments           Document[]          @relation("DocumentUpdater")
  savedVersions              DocumentVersion[]   @relation("DocumentVersionSaver")
  uploadedAttachments        DocumentAttachment[] @relation("DocumentAttachmentUploader")
  documentPermissions        DocumentPermission[] @relation("DocumentPermissionUser")
  grantedPermissions         DocumentPermission[] @relation("DocumentPermissionGranter")
  createdTemplates           DocumentTemplate[]  @relation("DocumentTemplateCreator")
  dailyReports               DailyReport[]
  receivedNotifications      Notification[]      @relation("ReceivedNotifications")
  sentNotifications          Notification[]      @relation("NotificationActor")
  pushSubscriptions          PushSubscription[]

  // Sprint management (M3.5)
  createdSprints Sprint[] @relation("SprintCreator")
}

model Department {
  id          String    @id @default(cuid())
  name        String
  description String?
  managerId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users     User[]
  projects  Project[]
  meetings  Meeting[]
  documents Document[]
}

model SystemConfig {
  id                 String   @id @default(cuid())
  companyName        String
  companyLogoUrl     String?
  timezone           String   @default("Asia/Ho_Chi_Minh")
  workStartTime      String   @default("08:00")
  workEndTime        String   @default("17:30")
  checkinStartTime   String   @default("06:00")
  checkinEndTime     String   @default("12:00")
  allowedIpRanges    String[]
  officeLatitude     Float
  officeLongitude    Float
  gpsRadiusMeters    Int      @default(100)
  wfhAutoApproveTime String   @default("09:30")
  geminiApiKey       String?
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPass           String?
  updatedAt          DateTime @updatedAt
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  date          DateTime         @db.Date
  status        AttendanceStatus
  checkInTime   DateTime?
  checkOutTime  DateTime?
  checkInIp     String?
  checkInLat    Float?
  checkInLng    Float?
  checkInMethod String?
  note          String?
  editedBy      String?
  editedAt      DateTime?
  createdAt     DateTime         @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

model EarlyLeaveRequest {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation("EarlyLeaveRequester", fields: [userId], references: [id])
  date              DateTime      @db.Date
  expectedLeaveTime DateTime
  reason            String
  status            RequestStatus @default(PENDING)
  reviewedBy        String?
  reviewedByUser    User?         @relation("EarlyLeaveReviewer", fields: [reviewedBy], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@index([status])
}

model OvertimeRequest {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation("OvertimeRequester", fields: [userId], references: [id])
  date            DateTime      @db.Date
  registeredStart DateTime
  registeredEnd   DateTime
  registeredHours Float
  actualHours     Float?
  reason          String
  status          RequestStatus @default(PENDING)
  reviewedBy      String?
  reviewedByUser  User?         @relation("OvertimeReviewer", fields: [reviewedBy], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@index([status])
}

model BreakLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  date      DateTime  @db.Date
  startTime DateTime
  endTime   DateTime?
  duration  Int?
  reason    String?
  type      BreakType @default(MANUAL)
  createdAt DateTime  @default(now())

  @@index([userId, date])
}

model WfhRequest {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  date          DateTime      @db.Date
  reason        String
  expectedStart String
  expectedEnd   String
  status        RequestStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  rejectionNote String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model LeaveRequest {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  startDate  DateTime      @db.Date
  endDate    DateTime      @db.Date
  leaveType  LeaveType
  reason     String
  status     RequestStatus @default(PENDING)
  dayCount   Float
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Project {
  id              String               @id @default(cuid())
  name            String
  description     String?
  kind            ProjectKind          @default(TEAM)
  workflowType    ProjectWorkflowType  @default(KANBAN)
  personalOwnerId String?              @unique
  personalOwner   User?                @relation("PersonalProjectOwner", fields: [personalOwnerId], references: [id])
  pmId            String?              // ← MỚI (M3.5): PM chính của project (DEPT_HEAD chỉ định)
  pm              User?                @relation("ProjectManager", fields: [pmId], references: [id])
  departmentId    String?              // ← MỚI (M3.5): Phòng ban quản lý dự án
  department      Department?          @relation(fields: [departmentId], references: [id])
  status          ProjectStatus        @default(PLANNING)
  color           String               @default("#3B82F6")
  icon            String?
  startDate       DateTime?
  endDate         DateTime?
  createdById     String
  createdBy       User                 @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  members      ProjectMember[]
  sprints      Sprint[]
  epics        Epic[]
  tasks        Task[]
  customFields CustomField[]
  meetings     Meeting[]
  documents    Document[]
  quickTasks   QuickTask[]   // ← MỚI (M3.5)
}

model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  projectRole String
  joinedAt    DateTime @default(now())

  @@unique([projectId, userId])
}

model Sprint {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  name         String
  goal         String?
  status       SprintStatus @default(PLANNING)
  startDate    DateTime?
  endDate      DateTime?
  durationDays Int          @default(14)   // ← MỚI (M3.5)
  completedAt  DateTime?                 // ← MỚI (M3.5)
  createdById  String?                   // ← MỚI (M3.5)
  createdBy    User?        @relation("SprintCreator", fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?                 // ← MỚI (M3.5): soft delete

  epics Epic[]
  tasks Task[]

  @@index([projectId, status])
}

model Epic {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  sprintId    String?
  sprint      Sprint?   @relation(fields: [sprintId], references: [id])
  title       String
  description String?
  color       String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tasks Task[]
}

model Task {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  sprintId     String?
  sprint       Sprint?    @relation(fields: [sprintId], references: [id])
  epicId       String?
  epic         Epic?      @relation(fields: [epicId], references: [id])
  parentTaskId String?
  parentTask   Task?      @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     Task[]     @relation("SubTasks")
  assigneeId   String?
  assignee     User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById   String
  createdBy     User       @relation("TaskCreator", fields: [createdById], references: [id])
  completedById String?
  completedBy   User?      @relation("TaskCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?
  title         String
  description  String?
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  storyPoints  Int?
  timeEstimate Int?
  timeTracked  Int        @default(0)
  position     Int        @default(0)
  dueDate      DateTime?
  labels       String[]
  notified24h  Boolean    @default(false)
  notified1h   Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  dependencies  TaskDependency[]   @relation("TaskDependsOn")
  dependentOnMe TaskDependency[]   @relation("TaskDependencySource")
  workLogs      WorkLog[]
  comments      Comment[]
  customValues  CustomFieldValue[]
  linkedDocuments Document[]       @relation("DocumentLinkedTask")

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([sprintId])
}

model TaskDependency {
  id             String         @id @default(cuid())
  taskId         String
  task           Task           @relation("TaskDependsOn", fields: [taskId], references: [id])
  dependsOnId    String
  dependsOnTask  Task           @relation("TaskDependencySource", fields: [dependsOnId], references: [id])
  dependencyType DependencyType

  @@unique([taskId, dependsOnId])
}

model WorkLog {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  duration    Int
  description String?
  logDate     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id        String    @id @default(cuid())
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id])
  docId     String?
  meetingId String?
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String
  mentions  String[]
  isEdited  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reactions Reaction[]
}

model Reaction {
  id        String  @id @default(cuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  emoji     String

  @@unique([commentId, userId, emoji])
}

model CustomField {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id])
  name      String
  fieldType CustomFieldType
  options   String[]
  createdAt DateTime        @default(now())

  values CustomFieldValue[]
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id])
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id])
  value         String
  updatedAt     DateTime    @updatedAt

  @@unique([taskId, customFieldId])
}

model Meeting {
  id           String        @id @default(cuid())
  title        String
  description  String?

  // Scope type — phân biệt 3 loại meeting
  scopeType    MeetingScope  @default(ONE_ON_ONE)
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id])

  startTime    DateTime
  endTime      DateTime
  status       MeetingStatus @default(SCHEDULED)
  roomCode     String        @unique @default(cuid())
  createdById  String
  createdBy    User          @relation("MeetingCreator", fields: [createdById], references: [id])
  attendees          MeetingAttendee[]
  minutes            MeetingMinute?
  transcriptChunks   MeetingTranscriptChunk[]
  linkedDocuments    Document[]    @relation("DocumentLinkedMeeting")
  rsvpReminderSentAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([scopeType, projectId, departmentId])
  @@index([startTime, status])
}

model MeetingAttendee {
  id                   String    @id @default(cuid())
  meetingId            String
  meeting              Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId               String
  user                 User      @relation(fields: [userId], references: [id])

  rsvp                 RSVP      @default(PENDING)
  rsvpAt               DateTime?

  joinedAt             DateTime?
  leftAt               DateTime?
  totalDurationSeconds Int       @default(0)

  @@unique([meetingId, userId])
  @@index([userId, rsvp])
}

model MeetingMinute {
  id        String   @id @default(cuid())
  meetingId String   @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content   String   @db.Text

  // ⭐ M5.1 — AI Summary & Live Transcript fields
  rawTranscript       String?   @db.Text
  isTranscribing      Boolean   @default(false)
  aiSummary           String?   @db.Text
  actionItems         Json?
  decisions           Json?
  risksAndQuestions   Json?
  aiGeneratedAt       DateTime?
  aiModel             String?
  aiTokensUsed        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingId])
}

model MeetingTranscriptChunk {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speakerId   String
  speakerName String
  speakerRole String?
  text        String   @db.Text
  timestamp   DateTime @default(now())

  @@index([meetingId, timestamp])
}

model Document {
  id              String        @id @default(cuid())
  title           String
  content         Json          // Tiptap JSON
  contentText     String        @db.Text // Plain text cho search / FTS
  scope           DocumentScope
  type            DocumentType  @default(STANDARD)

  // Owner
  ownerId         String
  owner           User          @relation("DocumentOwner", fields: [ownerId], references: [id])

  // Scope relations
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
  departmentId    String?
  department      Department?   @relation(fields: [departmentId], references: [id])

  // Linked entities (cho U1, U2, U4)
  linkedTaskId    String?
  linkedTask      Task?         @relation("DocumentLinkedTask", fields: [linkedTaskId], references: [id])
  linkedMeetingId String?
  linkedMeeting   Meeting?      @relation("DocumentLinkedMeeting", fields: [linkedMeetingId], references: [id])

  // Metadata
  aiSummary       String?       @db.Text
  templateKey     String?       // 'meeting_minutes', 'project_proposal', ...
  parentId        String?       // Nested folders
  parent          Document?     @relation("DocumentTree", fields: [parentId], references: [id])
  children        Document[]    @relation("DocumentTree")
  tags            String[]      // ['spec', 'design', 'urgent']

  // Versioning
  currentVersion  Int           @default(1)
  versions        DocumentVersion[]

  // Attachments
  attachments     DocumentAttachment[]

  // Access
  permissions     DocumentPermission[]

  // Stats
  viewCount       Int           @default(0)
  lastViewedAt    DateTime?

  // Audit
  createdById     String
  createdBy       User          @relation("DocumentCreator", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?         @relation("DocumentUpdater", fields: [updatedById], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([scope, deletedAt])
  @@index([projectId, deletedAt])
  @@index([departmentId, deletedAt])
  @@index([linkedTaskId])
  @@index([linkedMeetingId])
  @@index([ownerId, deletedAt])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  title        String
  content      Json
  contentText  String   @db.Text
  changeNote   String?
  savedById    String
  savedBy      User     @relation("DocumentVersionSaver", fields: [savedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId, version])
}

model DocumentAttachment {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName      String
  fileSize      Int      // bytes
  mimeType      String
  minioKey      String   // path file
  minioBucket   String   @default("worksync-documents")
  uploadedById  String
  uploadedBy    User     @relation("DocumentAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([documentId])
}

model DocumentPermission {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("DocumentPermissionUser", fields: [userId], references: [id])
  canEdit      Boolean  @default(false)
  canComment   Boolean  @default(true)
  canShare     Boolean  @default(false)
  grantedById  String
  grantedBy    User     @relation("DocumentPermissionGranter", fields: [grantedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
}

model DocumentTemplate {
  id            String   @id @default(cuid())
  key           String   @unique  // 'meeting_minutes', 'project_proposal', 'weekly_report'
  name          String   // "Biên bản họp", "Đề xuất dự án"
  description   String?
  content       Json     // Tiptap JSON template
  scope         DocumentScope
  createdById   String
  createdBy     User     @relation("DocumentTemplateCreator", fields: [createdById], references: [id])
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DailyReport {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  date            DateTime  @db.Date
  content         String
  tasksDone       String[]
  blockers        String?
  plannedTomorrow String?
  aiDrafted       Boolean   @default(false)
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  category  String
  title     String
  body      String?
  data      Json?
  icon      String?

  isRead    Boolean          @default(false)
  readAt    DateTime?

  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@index([userId, isRead, createdAt])
  @@index([userId, type, createdAt])
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint   String    @unique
  p256dh     String
  auth       String

  userAgent  String?
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, isActive])
}


// ------------------------------------------------------
// M3.5: QuickTask — Giao việc nhanh (không cần sprint)
// ------------------------------------------------------

model QuickTask {
  id           String     @id @default(cuid())
  title        String
  description  String?
  projectId    String?    // null = personal (không thuộc project nào)
  project      Project?   @relation(fields: [projectId], references: [id])
  assigneeId   String
  assignee     User       @relation("QuickTaskAssignee", fields: [assigneeId], references: [id])
  assignedById String
  assignedBy   User       @relation("QuickTaskAssigner", fields: [assignedById], references: [id])
  dueDate      DateTime
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(TODO)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([projectId])
}
